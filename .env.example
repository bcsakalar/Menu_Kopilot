# Menü Kopilot — ortam değişkenleri.
# `.env` adıyla kopyala (asla commit etme). `docker compose up` .env olmadan da geliştirme varsayılanlarıyla çalışır.
# Sağlayıcı API anahtarları YALNIZCA burada, sunucuda durur; web paketine asla girmez.
# Üretim dosyası scripts/new-prod-env.ps1 ile ayrıca oluşturulur (NODE_ENV=production orada yazılır).

# --- Çalışma ----------------------------------------------------------------------
# production: zayıf sırlarla açılmaz, çerezleri Secure yapar. Yerelde development kullan.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Proxy arkasında gerçek istemci IP'si X-Forwarded-For'dan gelir.
TRUST_PROXY=true
# api | worker | all  (all = HTTP API + embedding işçisi tek süreçte; küçük sunucu için en iyisi)
ROLE=all

# --- Veri depoları ----------------------------------------------------------------
# docker compose bunları kendi servis adlarıyla değiştirir.
DATABASE_URL=postgres://menu:menu@localhost:5432/menu_kopilot
REDIS_URL=redis://localhost:6379
POSTGRES_USER=menu
POSTGRES_PASSWORD=menu
POSTGRES_DB=menu_kopilot

# --- Giriş ------------------------------------------------------------------------
# En az 32 rastgele karakter, örn. `openssl rand -base64 48`. Üretimde zorunlu.
JWT_SECRET=
JWT_ACCESS_TTL=12h
# Yönetim paneli hesabı (/admin); yoksa tohumlama oluşturur. Sitenin kendisinde giriş yoktur.
# Şifre boşsa geliştirmede change-me-now kullanılır (üretim bunu reddeder).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Uzman
# Açılışta migration'ları ve tohumlamayı çalıştır.
SEED_ON_START=true

# --- Yapay zekâ sağlayıcıları (yalnızca sunucuda) -----------------------------------
# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq Console → https://console.groq.com/keys
GROQ_API_KEY=
# true = hiçbir dış API'ye gitme; yalnızca veritabanı ve önbellek (bu modda yeni görüntü okunamaz).
LOCAL_ONLY_MODE=false

# --- Bütçe ve kotalar ---------------------------------------------------------------
DAILY_LLM_CALL_QUOTA=1000
DAILY_TOKEN_QUOTA=5000000
# Site geneli tavan: site açık olduğu için çerezini silen ziyaretçi yeni kota alır, bu tavanı alamaz.
GLOBAL_DAILY_LLM_CALL_QUOTA=10000
QUOTA_TIMEZONE=Europe/Istanbul
REQUEST_MAX_LLM_CALLS=6
REQUEST_MAX_INPUT_TOKENS=25000

# --- Havuz eşleşmesi ve önbellek -----------------------------------------------------
RETRIEVAL_TRGM_THRESHOLD=0.72
RETRIEVAL_VECTOR_THRESHOLD=0.85
CACHE_TTL_DAYS=30

# --- Yüklemeler ---------------------------------------------------------------------
UPLOAD_MAX_FILES=5
UPLOAD_MAX_FILE_MB=8

# --- Yük ve uyarılar ----------------------------------------------------------------
# Aynı anda çalışan analiz sayısı; fazlası sırasını görerek bekler. Sıra da doluysa "çok yoğunuz" denir.
ANALYSIS_CONCURRENCY=10
ANALYSIS_QUEUE_MAX=50
# Yük uyarıları için ntfy konu adresi (örn. https://ntfy.sh/konu-adi). Boş = uyarı yok.
ALERT_NTFY_URL=

# --- Bilgisayardaki portlar (docker compose) -----------------------------------------
# Uygulama yalnızca 127.0.0.1 üzerinde açılır; 3000 doluysa değiştir (üretimde 3030).
API_PORT=3000

# --- Ters proxy (Caddy) -------------------------------------------------------------
# Otomatik HTTPS için alan adı, örn. api.example.com. `:80` = düz HTTP (yerel).
SITE_ADDRESS=:80
