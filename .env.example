# Menü Kopilot — environment variables.
# Copy to `.env` (never commit it). `docker compose up` also works WITHOUT a .env file using dev defaults.
# Provider API keys live ONLY here on the server — never in the mobile app.

# --- Runtime -------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Behind Caddy the real client IP comes from X-Forwarded-For.
TRUST_PROXY=true
# api | worker | all  (all = HTTP API + embedding worker in one process; best for a 1 GB droplet)
ROLE=all

# --- Data stores ---------------------------------------------------------------
# docker compose overrides these with the internal service hostnames.
DATABASE_URL=postgres://menu:menu@localhost:5432/menu_kopilot
REDIS_URL=redis://localhost:6379
POSTGRES_USER=menu
POSTGRES_PASSWORD=menu
POSTGRES_DB=menu_kopilot

# --- Auth ----------------------------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 48`. Required in production.
JWT_SECRET=
JWT_ACCESS_TTL=12h
REFRESH_TOKEN_TTL_DAYS=90
# Single user account, created by the seed if it does not exist yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Uzman
# Run migrations + idempotent seed at container start.
SEED_ON_START=true

# --- AI providers (server side only) -------------------------------------------
# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq Console → https://console.groq.com/keys
GROQ_API_KEY=
# true = never call any external API; answer only from DB/cache (photos cannot be read in this mode).
LOCAL_ONLY_MODE=false

# --- Budget & quotas -----------------------------------------------------------
DAILY_LLM_CALL_QUOTA=300
DAILY_TOKEN_QUOTA=1500000
QUOTA_TIMEZONE=Europe/Istanbul
REQUEST_MAX_LLM_CALLS=6
REQUEST_MAX_INPUT_TOKENS=25000

# --- Retrieval & cache ---------------------------------------------------------
RETRIEVAL_TRGM_THRESHOLD=0.72
RETRIEVAL_VECTOR_THRESHOLD=0.85
CACHE_TTL_DAYS=30

# --- Uploads -------------------------------------------------------------------
UPLOAD_MAX_FILES=5
UPLOAD_MAX_FILE_MB=8

# --- Ports on the host (docker compose) ----------------------------------------
# The API is published on 127.0.0.1 only; change it when 3000 is taken (production default: 3030).
API_PORT=3000

# --- Reverse proxy (Caddy) -----------------------------------------------------
# Public hostname for automatic HTTPS, e.g. api.example.com. `:80` = plain HTTP (local).
SITE_ADDRESS=:80
