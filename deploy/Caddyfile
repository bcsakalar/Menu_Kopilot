# SITE_ADDRESS=api.example.com → automatic HTTPS (Let's Encrypt). Default ":80" = plain HTTP for local use.
{$SITE_ADDRESS::80} {
	request_body {
		max_size 45MB
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}

	# flush_interval -1 → no buffering, so a chat answer reaches the browser as soon as it is produced.
	reverse_proxy api:3000 {
		flush_interval -1
	}
}
