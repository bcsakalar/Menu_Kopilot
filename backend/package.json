{
  "name": "menu-kopilot-api",
  "version": "0.1.0",
  "private": true,
  "description": "Menü Kopilot backend: suggestion + gap-analysis pipelines for platform branch openings",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "fixtures:images": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-fixture-images.ps1",
    "fixtures:record": "tsx --env-file-if-exists=../.env scripts/record-fixtures.ts",
    "live:check": "tsx --env-file-if-exists=../.env scripts/live-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate.ts",
    "db:rollback": "tsx --env-file-if-exists=../.env src/db/rollback.ts",
    "db:seed": "tsx --env-file-if-exists=../.env src/db/seed/run.ts",
    "user:add": "tsx --env-file-if-exists=../.env src/db/seed/add-user.ts",
    "db:export-seed": "tsx --env-file-if-exists=../.env src/db/seed/export-seed.ts",
    "measure": "tsx --env-file-if-exists=../.env scripts/measure-quality.ts",
    "probe:recommender": "tsx --env-file-if-exists=../.env scripts/probe-recommender.ts",
    "compare": "tsx scripts/compare-quality.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@google/genai": "^2.22.0",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
