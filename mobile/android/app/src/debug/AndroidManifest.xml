<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds may talk to a local backend over plain HTTP (e.g. http://10.0.2.2:3000).
         Release builds only use HTTPS (Caddy terminates TLS on the VPS). -->
    <application
        android:label="Kopilot TEST"
        android:usesCleartextTraffic="true"
        tools:replace="android:label,android:usesCleartextTraffic"/>
</manifest>
